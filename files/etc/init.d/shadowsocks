#!/bin/sh /etc/rc.common

START=99
STOP=10

SS_CONF="/etc/shadowsocks-libev/config.json"
SS_REDIR_PID="/var/run/ss-redir.pid"
SS_TUNNEL_PID="/var/run/ss-tunnel.pid"
CHNROUTE="/etc/shadowsocks-libev/chnroute.txt"

start() {
    if grep -q "YOUR_SERVER" "$SS_CONF"; then
        echo "Please edit $SS_CONF first"
        return 1
    fi

    ss-redir -c "$SS_CONF" -f "$SS_REDIR_PID"
    ss-tunnel -c "$SS_CONF" -l 5353 -L 8.8.8.8:53 -f "$SS_TUNNEL_PID"
    setup_iptables
    setup_dns
}

stop() {
    restore_dns
    cleanup_iptables
    kill "$(cat "$SS_REDIR_PID" 2>/dev/null)" 2>/dev/null
    kill "$(cat "$SS_TUNNEL_PID" 2>/dev/null)" 2>/dev/null
    rm -f "$SS_REDIR_PID" "$SS_TUNNEL_PID"
}

get_server_ip() {
    local server
    server=$(jsonfilter -i "$SS_CONF" -e '@.server')
    resolveip -4 "$server" 2>/dev/null | head -1
}

setup_dns() {
    uci set dhcp.@dnsmasq[0].noresolv='1'
    uci -q delete dhcp.@dnsmasq[0].server
    uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#5353'
    uci commit dhcp
    /etc/init.d/dnsmasq restart
}

restore_dns() {
    uci -q delete dhcp.@dnsmasq[0].noresolv
    uci -q delete dhcp.@dnsmasq[0].server
    uci commit dhcp
    /etc/init.d/dnsmasq restart
}

setup_iptables() {
    local server_ip
    server_ip=$(get_server_ip)

    # Load chnroute into ipset
    ipset create chnroute hash:net -exist
    if [ -f "$CHNROUTE" ]; then
        sed 's/^/add chnroute /' "$CHNROUTE" | ipset restore -exist
    fi

    iptables -t nat -N SS_REDIR 2>/dev/null || return
    # Skip private/reserved
    iptables -t nat -A SS_REDIR -d 0.0.0.0/8 -j RETURN
    iptables -t nat -A SS_REDIR -d 10.0.0.0/8 -j RETURN
    iptables -t nat -A SS_REDIR -d 127.0.0.0/8 -j RETURN
    iptables -t nat -A SS_REDIR -d 169.254.0.0/16 -j RETURN
    iptables -t nat -A SS_REDIR -d 172.16.0.0/12 -j RETURN
    iptables -t nat -A SS_REDIR -d 192.168.0.0/16 -j RETURN
    iptables -t nat -A SS_REDIR -d 224.0.0.0/4 -j RETURN
    iptables -t nat -A SS_REDIR -d 240.0.0.0/4 -j RETURN
    # Skip SS server
    [ -n "$server_ip" ] && iptables -t nat -A SS_REDIR -d "$server_ip" -j RETURN
    # Skip China IPs
    iptables -t nat -A SS_REDIR -m set --match-set chnroute dst -j RETURN
    # Redirect TCP to ss-redir
    iptables -t nat -A SS_REDIR -p tcp -j REDIRECT --to-ports 1080

    iptables -t nat -A PREROUTING -p tcp -j SS_REDIR

    # DNS hijack
    iptables -t nat -A PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 53

    # Block QUIC
    iptables -A FORWARD -p udp --dport 443 -j DROP
}

cleanup_iptables() {
    iptables -t nat -D PREROUTING -p tcp -j SS_REDIR 2>/dev/null
    iptables -t nat -F SS_REDIR 2>/dev/null
    iptables -t nat -X SS_REDIR 2>/dev/null
    iptables -t nat -D PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 53 2>/dev/null
    iptables -D FORWARD -p udp --dport 443 -j DROP 2>/dev/null
    ipset destroy chnroute 2>/dev/null
}
