#!/bin/sh
# First boot: configure LAN IP, enable shadowsocks, setup cron

# LAN IP: avoid conflict with main router (192.168.1.x)
uci set network.lan.ipaddr='192.168.2.1'
uci commit network

chmod +x /etc/init.d/shadowsocks
/etc/init.d/shadowsocks enable

# Cron: ss-redir watchdog every 5 minutes
chmod +x /etc/shadowsocks-libev/watchdog.sh
echo "*/5 * * * * /etc/shadowsocks-libev/watchdog.sh" >> /etc/crontabs/root

# Cron: reboot daily at 4:30 AM
echo "30 4 * * * reboot" >> /etc/crontabs/root

/etc/init.d/cron enable
/etc/init.d/cron start
